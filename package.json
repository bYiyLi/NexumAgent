{
  "name": "nexum-agent",
  "version": "0.0.1",
  "private": true,
  "description": "Nexum local-first TypeScript Agent (initial scaffold)",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "pnpm@10.34.5",
  "bin": {
    "nexum-agent": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "contracts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --experimental-vm-modules --test",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "file-type": "22.3.0",
    "ignore": "7.0.14",
    "image-size": "2.1.0",
    "music-metadata": "12.5.0",
    "yaml": "2.9.1"
  }
}
