{
  "name": "@nexum-hub/agent",
  "version": "0.0.1",
  "private": false,
  "description": "Nexum Agent managed Node execution host",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bYiyLi/NexumAgent.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "packageManager": "pnpm@10.34.5",
  "exports": {
    ".": "./dist/index.js",
    "./extension-api": {
      "types": "./dist/extension-api.d.ts",
      "default": "./dist/extension-api.js"
    }
  },
  "files": [
    "dist",
    "builtin",
    "contracts",
    "skills",
    "!**/*.map"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "build:extension-api": "node scripts/build-extension-api.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --experimental-vm-modules --test --test-concurrency=2 \"test/*.test.mjs\"",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dts-bundle-generator": "10.0.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "^3.0.1",
    "file-type": "22.3.0",
    "ignore": "7.0.14",
    "image-size": "2.1.0",
    "koffi": "3.3.8",
    "music-metadata": "12.5.0",
    "node-pty": "1.2.0-beta.18",
    "yaml": "2.9.1"
  }
}
