{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexum.local/agent/v2/model/agent.close.output.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "projectId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "closed": {
          "const": true
        },
        "agentConfirmed": {
          "type": "boolean"
        },
        "affectedContextIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 1000
        },
        "closedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?Z$"
        }
      },
      "required": ["contextId", "projectId", "closed", "agentConfirmed"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "projectId": {
                "type": "null"
              }
            },
            "required": ["projectId"]
          },
          "then": {
            "properties": {
              "agentConfirmed": {
                "const": true
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "message": {
              "type": "string",
              "maxLength": 4096
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          },
          "required": ["code", "message", "retryable"],
          "additionalProperties": false
        },
        "run": {
          "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Run"
        }
      },
      "required": ["error"],
      "additionalProperties": false
    }
  ]
}
