{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexum.local/agent/v2/model/agent.run.start.output.schema.json",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "run": {
          "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Run"
        },
        "wait": {
          "anyOf": [
            {
              "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Wait"
            },
            {
              "type": "null"
            }
          ]
        },
        "operations": {
          "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Items"
        },
        "resources": {
          "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Items"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?Z$"
        },
        "code": {
          "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/TextPage"
        },
        "input": {},
        "logs": {
          "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/TextPage"
        },
        "accepted": {
          "type": "boolean"
        },
        "unavailable": {
          "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Error"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "hasValue",
            "items",
            "resources",
            "references",
            "conversions",
            "delivery"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "pending",
                "ready",
                "unavailable"
              ]
            },
            "hasValue": {
              "type": "boolean"
            },
            "value": {},
            "items": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object"
              }
            },
            "resources": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object"
              }
            },
            "references": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "target"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "target": {
                    "type": "string"
                  }
                }
              }
            },
            "conversions": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object"
              }
            },
            "mcpResults": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object"
              }
            },
            "delivery": {
              "type": "object",
              "required": [
                "representationComplete",
                "inlineComplete",
                "requiresResourceRead"
              ],
              "properties": {
                "representationComplete": {
                  "type": "boolean"
                },
                "inlineComplete": {
                  "type": "boolean"
                },
                "requiresResourceRead": {
                  "type": "boolean"
                },
                "reason": {
                  "type": "string"
                },
                "transfers": {
                  "type": "array"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "warnings": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        }
      },
      "required": [
        "run",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "message": {
              "type": "string",
              "maxLength": 4096
            },
            "retryable": {
              "type": "boolean"
            },
            "hint": {
              "type": "string",
              "maxLength": 2048
            },
            "nextAction": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "type",
                "label"
              ],
              "additionalProperties": false
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        },
        "run": {
          "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Run"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
