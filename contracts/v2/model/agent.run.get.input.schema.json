{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexum.local/agent/v2/model/agent.run.get.input.schema.json",
  "type": "object",
  "properties": {
    "agentId": {
      "$ref": "https://schemas.nexum.local/agent/v2/common.schema.json#/$defs/id"
    },
    "runId": {
      "$ref": "https://schemas.nexum.local/agent/v2/common.schema.json#/$defs/id"
    },
    "waitMs": {
      "$ref": "https://schemas.nexum.local/agent/v2/common.schema.json#/$defs/waitMs"
    },
    "read": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "code",
            "input",
            "logs"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 4,
          "maximum": 16384
        }
      },
      "required": [
        "kind",
        "offset",
        "maxBytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "agentId",
    "runId"
  ],
  "additionalProperties": false
}
