{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexum.local/agent/v2/model/agent.list.output.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agentId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 1048576
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "platform": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "arch": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": ["online", "offline"]
              },
              "blockedReason": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "projects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "projectId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "root": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8192
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 1048576
                    },
                    "descriptionSyncStatus": {
                      "enum": ["unknown", "ok", "missing", "unavailable"]
                    },
                    "descriptionSyncedAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?Z$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "descriptionSyncErrorCode": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "projectId",
                    "name",
                    "root",
                    "description",
                    "descriptionSyncStatus",
                    "descriptionSyncedAt",
                    "descriptionSyncErrorCode"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 20
              },
              "projectsNextCursor": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "agentId",
              "name",
              "platform",
              "arch",
              "status",
              "blockedReason",
              "projects",
              "projectsNextCursor",
              "description"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?Z$"
        }
      },
      "required": ["agents", "nextCursor", "observedAt"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "message": {
              "type": "string",
              "maxLength": 4096
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          },
          "required": ["code", "message", "retryable"],
          "additionalProperties": false
        },
        "run": {
          "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Run"
        }
      },
      "required": ["error"],
      "additionalProperties": false
    }
  ]
}
