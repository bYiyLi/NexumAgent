{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexum.local/agent/v2/model/agent.run.get.output.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "run": {
          "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Run"
        },
        "data": {},
        "wait": {
          "anyOf": [
            {
              "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Wait"
            },
            {
              "type": "null"
            }
          ]
        },
        "conversions": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 1000
        },
        "delivery": {
          "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/MCPDelivery"
        },
        "mcpResults": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 1000
        },
        "operations": {
          "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Items"
        },
        "resources": {
          "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Items"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?Z$"
        },
        "code": {
          "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/TextPage"
        },
        "input": {},
        "logs": {
          "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/TextPage"
        },
        "accepted": {
          "type": "boolean"
        },
        "unavailable": {
          "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Error"
        }
      },
      "required": ["run"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "message": {
              "type": "string",
              "maxLength": 4096
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          },
          "required": ["code", "message", "retryable"],
          "additionalProperties": false
        },
        "run": {
          "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Run"
        }
      },
      "required": ["error"],
      "additionalProperties": false
    }
  ]
}
