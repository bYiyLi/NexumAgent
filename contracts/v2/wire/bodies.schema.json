{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexum.local/agent/v2/wire/bodies.schema.json",
  "$defs": {
    "Icon": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "maxLength": 1048576
        },
        "mimeType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[^\\s/;]+/[^\\s;]+(?:;[^\\r\\n]+)?$"
        },
        "sizes": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "theme": {
          "enum": ["light", "dark"]
        }
      },
      "required": ["src"],
      "additionalProperties": false
    },
    "Content": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "maxLength": 1048576
            },
            "annotations": {
              "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Annotations"
            },
            "description": {
              "type": "string",
              "maxLength": 1048576
            }
          },
          "required": ["type", "text"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": ["image", "audio"]
            },
            "resource": {
              "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Artifact"
            },
            "mimeType": {
              "type": "string",
              "minLength": 3,
              "maxLength": 256,
              "pattern": "^[^\\s/;]+/[^\\s;]+(?:;[^\\r\\n]+)?$"
            },
            "annotations": {
              "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Annotations"
            },
            "description": {
              "type": "string",
              "maxLength": 1048576
            }
          },
          "required": ["type", "resource", "mimeType"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "resource_link"
            },
            "uri": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^nexum://agents/[^/?#]+/(?:resources|mcp)/"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "mimeType": {
              "type": "string",
              "minLength": 3,
              "maxLength": 256,
              "pattern": "^[^\\s/;]+/[^\\s;]+(?:;[^\\r\\n]+)?$"
            },
            "annotations": {
              "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Annotations"
            },
            "description": {
              "type": "string",
              "maxLength": 1048576
            },
            "title": {
              "type": "string",
              "maxLength": 1048576
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "icons": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "$ref": "https://schemas.nexum.local/agent/v2/wire/bodies.schema.json#/$defs/Icon"
              }
            }
          },
          "required": ["type", "uri", "name"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "resource"
            },
            "resource": {
              "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Artifact"
            },
            "uri": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^nexum://agents/[^/?#]+/(?:resources|mcp)/"
            },
            "encoding": {
              "enum": ["text", "blob"]
            },
            "annotations": {
              "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Annotations"
            },
            "description": {
              "type": "string",
              "maxLength": 1048576
            }
          },
          "required": ["type", "resource", "uri", "encoding"],
          "additionalProperties": false
        }
      ]
    },
    "ResourceEntry": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^nexum://agents/[^/?#]+/(?:resources|mcp)/"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "mimeType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[^\\s/;]+/[^\\s;]+(?:;[^\\r\\n]+)?$"
        },
        "description": {
          "type": "string",
          "maxLength": 1048576
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "title": {
          "type": "string",
          "maxLength": 1048576
        },
        "icons": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "https://schemas.nexum.local/agent/v2/wire/bodies.schema.json#/$defs/Icon"
          }
        },
        "annotations": {
          "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Annotations"
        }
      },
      "required": ["uri", "name"],
      "additionalProperties": false
    },
    "Result": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.nexum.local/agent/v2/wire/bodies.schema.json#/$defs/Content"
          },
          "maxItems": 1000
        },
        "data": {},
        "isError": {
          "type": "boolean"
        },
        "conversions": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 1000
        },
        "delivery": {
          "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/ResultDelivery"
        },
        "resultType": {
          "const": "complete"
        },
        "mcpResults": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 1000
        }
      },
      "required": ["content"],
      "additionalProperties": false
    },
    "ResourcesList": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "https://schemas.nexum.local/agent/v2/wire/bodies.schema.json#/$defs/ResourceEntry"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["resources", "nextCursor"],
      "additionalProperties": false
    },
    "MCPResourceContents": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "mimeType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[^\\s/;]+/[^\\s;]+(?:;[^\\r\\n]+)?$"
        },
        "text": {
          "type": "string",
          "maxLength": 134217728
        },
        "blob": {
          "type": "string",
          "maxLength": 134217728,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        "_meta": {
          "type": "object"
        },
        "icons": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "https://schemas.nexum.local/agent/v2/wire/bodies.schema.json#/$defs/Icon"
          }
        },
        "metadata": {},
        "name": {
          "type": "string",
          "maxLength": 1048576
        },
        "title": {
          "type": "string",
          "maxLength": 1048576
        },
        "description": {
          "type": "string",
          "maxLength": 1048576
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "annotations": {
          "$ref": "https://schemas.nexum.local/agent/v2/wire/types.schema.json#/$defs/Annotations"
        }
      },
      "required": ["uri"],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["text"],
          "properties": {
            "text": {}
          }
        },
        {
          "required": ["blob"],
          "properties": {
            "blob": {}
          }
        }
      ]
    },
    "ResourcesRead": {
      "type": "object",
      "properties": {
        "contents": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "https://schemas.nexum.local/agent/v2/wire/bodies.schema.json#/$defs/MCPResourceContents"
          }
        },
        "_meta": {
          "type": "object"
        },
        "icons": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "https://schemas.nexum.local/agent/v2/wire/bodies.schema.json#/$defs/Icon"
          }
        },
        "metadata": {},
        "resultType": {
          "const": "complete"
        },
        "ttlMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheScope": {
          "enum": ["public", "private"]
        }
      },
      "required": ["contents"],
      "additionalProperties": false
    }
  }
}
