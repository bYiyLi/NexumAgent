{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexum.local/agent/v2/common.schema.json",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "waitMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30000
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "requestId": {
      "type": "string",
      "pattern": "^req_[0-9]{13}_[0-9a-f]{32}$"
    },
    "status": {
      "enum": [
        "accepted",
        "preparing_inputs",
        "running",
        "waiting_input",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled",
        "interrupted"
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "message": {
          "type": "string",
          "maxLength": 4096
        },
        "details": {
          "type": "object"
        }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "hostAttachment": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "file_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "download_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "file_name": {
              "type": "string",
              "maxLength": 1024
            },
            "mime_type": {
              "type": "string",
              "maxLength": 256
            }
          },
          "required": ["file_id", "download_url"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "uri": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": ["uri"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "transferId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": ["transferId"],
          "additionalProperties": false
        }
      ]
    },
    "attachments": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "https://schemas.nexum.local/agent/v2/common.schema.json#/$defs/hostAttachment"
      }
    },
    "caller": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "principalId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "clientId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "host": {
              "type": "string",
              "maxLength": 256
            },
            "model": {
              "type": "string",
              "maxLength": 256
            },
            "hostRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "hostCapabilities": {
              "$ref": "https://schemas.nexum.local/agent/v2/common.schema.json#/$defs/hostCapabilities"
            },
            "hostFeatures": {
              "$ref": "https://schemas.nexum.local/agent/v2/common.schema.json#/$defs/hostFeatures"
            },
            "source": {
              "const": "mcp"
            },
            "grantId": {
              "$ref": "https://schemas.nexum.local/agent/v2/common.schema.json#/$defs/id"
            }
          },
          "required": ["principalId", "clientId"],
          "additionalProperties": false,
          "dependentRequired": {
            "hostRef": ["hostCapabilities"],
            "hostCapabilities": ["hostRef"],
            "hostFeatures": ["hostRef", "hostCapabilities"]
          }
        },
        {
          "$ref": "https://schemas.nexum.local/agent/v2/common.schema.json#/$defs/ownerSessionCaller"
        }
      ]
    },
    "hostFeatures": {
      "type": "object",
      "properties": {
        "sampling": {
          "type": "object",
          "properties": {
            "context": {
              "type": "object"
            },
            "tools": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "elicitation": {
          "type": "object",
          "properties": {
            "form": {
              "type": "object",
              "properties": {
                "applyDefaults": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            },
            "url": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "roots": {
          "type": "object",
          "properties": {
            "listChanged": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "hostCapabilities": {
      "type": "object",
      "properties": {
        "sampling": {
          "type": "boolean"
        },
        "elicitation": {
          "type": "boolean"
        },
        "roots": {
          "type": "boolean"
        }
      },
      "required": ["sampling", "elicitation", "roots"],
      "additionalProperties": false
    },
    "ownerSessionCaller": {
      "type": "object",
      "properties": {
        "principalId": {
          "$ref": "https://schemas.nexum.local/agent/v2/common.schema.json#/$defs/id"
        },
        "clientId": {
          "type": "string",
          "pattern": "^nexum-console:[0-9a-f]{64}$"
        },
        "source": {
          "const": "owner_session"
        },
        "sessionRef": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["principalId", "clientId", "source", "sessionRef"],
      "additionalProperties": false
    }
  }
}
